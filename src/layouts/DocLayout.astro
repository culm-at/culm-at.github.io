---
import BaseLayout from "./BaseLayout.astro";
import CulmLogoText from "../components/CulmLogoText.astro";

const { page, sections } = Astro.props;

const pageTitle = `${page.meta.title} | culm.at`;
---

<BaseLayout title={pageTitle} description={page.meta.description}>
  <header class="topbar">
    <a href="/" class="brand"><CulmLogoText /></a>
    <nav class="section-nav">
      {
        sections.map((section) => (
          <a href={section.basePath}>{section.title}</a>
        ))
      }
    </nav>
  </header>

  <article class="doc">
    <p class="doc-section">{page.meta.section}</p>
    <h1>{page.meta.title}</h1>
    <p class="doc-description">{page.meta.description}</p>
    <div class="doc-body" set:html={page.html} />
  </article>
</BaseLayout>

<script>
  // Click-to-zoom for content images: open the full-resolution image in a
  // native <dialog> lightbox. The markdown body is injected via set:html, so
  // the <img>s exist in the parsed DOM by the time this (deferred module) runs.
  const imgs = document.querySelectorAll<HTMLImageElement>(".doc-body img");
  if (imgs.length) {
    const dialog = document.createElement("dialog");
    dialog.className = "img-zoom";
    const fullImg = document.createElement("img");
    dialog.appendChild(fullImg);
    // Close on Escape (native), backdrop click, or clicking the enlarged image.
    dialog.addEventListener("click", () => dialog.close());
    document.body.appendChild(dialog);

    imgs.forEach((img) => {
      img.addEventListener("click", () => {
        fullImg.src = img.currentSrc || img.src;
        fullImg.alt = img.alt || "";
        dialog.showModal();
      });
    });
  }
</script>
