---
import BaseLayout from "./BaseLayout.astro";
import CulmLogoText from "../components/CulmLogoText.astro";

const { page, sections } = Astro.props;

// Secondary sources are side projects and stay out of the topbar; they are reachable
// from the muted link row on the homepage.
const navSections = sections.filter((section) => !section.secondary);

const pageTitle = `${page.meta.title} | culm.at`;
---

<BaseLayout title={pageTitle} description={page.meta.description}>
  <header class="topbar">
    <a href="/" class="brand"><CulmLogoText /></a>
    <nav class="section-nav">
      {
        navSections.map((section) => (
          <a href={section.basePath}>{section.title}</a>
        ))
      }
    </nav>
  </header>

  <article class="doc">
    <p class="doc-section">{page.meta.section}</p>
    <h1>{page.meta.title}</h1>
    <p class="doc-description">{page.meta.description}</p>
    <div class="doc-body" set:html={page.html} />
  </article>
</BaseLayout>

<script>
  // Click-to-zoom for content images: open the full-resolution image in a
  // native <dialog> lightbox. The markdown body is injected via set:html, so
  // the <img>s exist in the parsed DOM by the time this (deferred module) runs.
  const imgs = document.querySelectorAll<HTMLImageElement>(".doc-body img");
  if (imgs.length) {
    const dialog = document.createElement("dialog");
    dialog.className = "img-zoom";
    const fullImg = document.createElement("img");
    dialog.appendChild(fullImg);
    // Close on Escape (native), backdrop click, or clicking the enlarged image.
    dialog.addEventListener("click", () => dialog.close());
    document.body.appendChild(dialog);

    imgs.forEach((img) => {
      img.addEventListener("click", () => {
        fullImg.src = img.currentSrc || img.src;
        fullImg.alt = img.alt || "";
        dialog.showModal();
      });
    });
  }

  // Bookmarklet gallery. The hrefs are real `javascript:` URLs so they can be dragged
  // onto the bookmarks bar, but clicking one here would run it against culm.at itself,
  // which is only confusing -- show the drag hint instead.
  document.querySelectorAll<HTMLElement>(".bookmarklet").forEach((card) => {
    const link = card.querySelector<HTMLAnchorElement>(".bookmarklet-drag");
    const copy = card.querySelector<HTMLButtonElement>(".bookmarklet-copy");
    const hint = card.querySelector<HTMLElement>(".bookmarklet-hint");
    if (!link) return;

    link.addEventListener("click", (event) => {
      event.preventDefault();
      if (hint) hint.hidden = false;
    });

    copy?.addEventListener("click", async () => {
      // link.href is the resolved, encoded javascript: URL -- exactly what belongs in
      // the URL field of a manually created bookmark.
      await navigator.clipboard.writeText(link.href);
      copy.textContent = "Copied";
      setTimeout(() => {
        copy.textContent = "Copy";
      }, 1500);
    });
  });
</script>
