---
import "../styles/global.css";

const { title = "culm.at", description = "Decentralized content, centralized presentation." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/culmat_logo.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="shell">
      <slot />
    </main>
  </body>
</html>
